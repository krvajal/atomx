common --enable_bzlmod
build --cxxopt=-std=c++20 --host_cxxopt=-std=c++20
build --cxxopt=-Wall --cxxopt=-Wextra
build -c opt
test --test_output=errors

# SLATE backend: bazel build --config=slate //apps:atomx
build:slate --define=slate=1
build:slate --copt=-isystem/usr/lib/x86_64-linux-gnu/openmpi/include
build:slate --copt=-isystem/usr/local/cuda-12.6/include
